# Copy this file to ".env" and adjust the values for your machine.
# The app reads the environment variables directly, so export them in your
# shell or use a tool like dotenv if you prefer a .env file.

# HTTP port
PORT=3000

# MySQL / MariaDB connection
# XAMPP: start MySQL in the XAMPP Control Panel.
# The defaults below match a standard XAMPP install (root, no password).
# Note: only one server can use port 3306 - if the "MySQL80" Windows service
# is running, stop it with "net stop MySQL80" or change DB_PORT.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=quiznova
DB_POOL_SIZE=10

# Secret used to sign the session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
