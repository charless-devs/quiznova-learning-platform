<%- include('partials/head', { title: 'QuizNova - Assessments & Quizzes', page: 'assessment' }) %>
<body class="bg-appBg text-slate-200 min-h-screen flex flex-col lg:flex-row antialiased overflow-x-hidden selection:bg-brand-500 selection:text-white">

    <!-- Toast Notifications Container -->
    <div id="toastContainer" class="fixed top-5 right-5 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none"></div>

    <!-- MOBILE HEADER NAVBAR -->
    <header class="lg:hidden flex items-center justify-between p-4 bg-cardBg border-b border-borderBg sticky top-0 z-40">
        <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-brand-600 to-coral-500 flex items-center justify-center shadow-lg shadow-brand-500/20">
                <i data-lucide="sparkles" class="w-4 h-4 text-white"></i>
            </div>
            <span class="text-base font-bold text-white tracking-tight">Quiz<span class="text-brand-400">Nova</span></span>
        </div>
        <div class="flex items-center gap-3">
            <button onclick="toggleMobileMenu()" class="p-2 text-slate-400 hover:text-white rounded-lg bg-inputBg border border-borderBg">
                <i data-lucide="menu" class="w-5 h-5"></i>
            </button>
        </div>
    </header>

    <!-- SIDEBAR NAVIGATION -->
    <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-64 bg-cardBg border-r border-borderBg flex flex-col justify-between p-5 transition-transform duration-300 transform -translate-x-full lg:translate-x-0 lg:static lg:z-auto">
        <div>
            <!-- Sidebar Header / Logo -->
            <div class="hidden lg:flex items-center gap-3 mb-8 px-2">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-brand-600 to-coral-500 flex items-center justify-center shadow-lg shadow-brand-500/30">
                    <i data-lucide="sparkles" class="w-5 h-5 text-white"></i>
                </div>
                <span class="text-xl font-extrabold tracking-tight text-white">Quiz<span class="text-brand-400">Nova</span></span>
            </div>

            <!-- Navigation Links -->
            <nav class="space-y-1">
                <a href="/dashboard" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-hoverBg transition-colors text-xs font-medium group">
                    <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                    <span>Dashboard</span>
                </a>
                <a href="/classes" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-hoverBg transition-colors text-xs font-medium group">
                    <div class="flex items-center gap-3">
                        <i data-lucide="book-open" class="w-4 h-4 group-hover:text-brand-400 transition-colors"></i>
                        <span>Classes</span>
                    </div>
                    <span class="px-2 py-0.5 text-[10px] bg-brand-500/20 text-brand-300 rounded-full font-bold">6</span>
                </a>
                <a href="/courses" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-hoverBg transition-colors text-xs font-medium group">
                    <div class="flex items-center gap-3">
                        <i data-lucide="graduation-cap" class="w-4 h-4 group-hover:text-brand-400 transition-colors"></i>
                        <span>Courses</span>
                    </div>
                    <span class="px-2 py-0.5 text-[10px] bg-brand-500/20 text-brand-300 rounded-full font-bold"><%= typeof courseCount !== 'undefined' ? courseCount : 0 %></span>
                </a>
                <a href="/materials" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-hoverBg transition-colors text-xs font-medium group">
                    <i data-lucide="folder-kanban" class="w-4 h-4"></i>
                    <span>Materials</span>
                </a>
                <a href="/assessment" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl bg-gradient-to-r from-brand-600 to-brand-700 text-white font-semibold text-xs shadow-md shadow-brand-600/20">
                    <div class="flex items-center gap-3">
                        <i data-lucide="award" class="w-4 h-4"></i>
                        <span>Assessments</span>
                    </div>
                    <span class="px-2 py-0.5 text-[10px] bg-white/20 text-white rounded-full font-bold"><%= quizzes.length %></span>
                </a>
                <a href="/analytics" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-hoverBg transition-colors text-xs font-medium group">
                    <i data-lucide="bar-chart-2" class="w-4 h-4"></i>
                    <span>Analytics</span>
                </a>
                <a href="/community" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-hoverBg transition-colors text-xs font-medium group">
                    <i data-lucide="users" class="w-4 h-4"></i>
                    <span>Community</span>
                </a>
                <a href="/messages" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-hoverBg transition-colors text-xs font-medium group">
                    <div class="flex items-center gap-3">
                        <i data-lucide="message-square" class="w-4 h-4 group-hover:text-brand-400 transition-colors"></i>
                        <span>Messages</span>
                    </div>
                    <span class="px-2 py-0.5 text-[10px] bg-coral-500 text-white rounded-full font-bold">3</span>
                </a>

                <div class="pt-4 mt-4 border-t border-borderBg/70 space-y-1">
                    <%- include("partials/admin-link", { user: user }) %>
                    <a href="/settings" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-slate-400 hover:text-white hover:bg-hoverBg transition-colors text-xs font-medium group">
                        <i data-lucide="settings" class="w-4 h-4"></i>
                        <span>Settings</span>
                    </a>
                </div>
            </nav>
        </div>

        <!-- Profile Widget Sidebar -->
        <div class="pt-4 border-t border-borderBg/70 flex items-center justify-between">
            <a href="/profile" class="group flex items-center gap-3 flex-1 min-w-0 rounded-xl px-2 py-1.5 -mx-2 hover:bg-hoverBg transition-colors" title="Open my progress">
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=200" alt="<%= user ? user.name : 'Student' %>" class="w-9 h-9 rounded-xl object-cover ring-2 ring-brand-500/40 group-hover:ring-brand-400 transition-all flex-shrink-0">
                <div class="min-w-0">
                    <h4 class="text-xs font-bold text-white truncate group-hover:text-brand-300 transition-colors"><%= user ? user.name : 'Rock Lee' %></h4>
                    <p class="text-[10px] text-slate-400 truncate group-hover:text-slate-300 transition-colors">View my progress</p>
                </div>
                <i data-lucide="chevron-right" class="w-4 h-4 ml-auto text-slate-500 opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all flex-shrink-0"></i>
            </a>
            <button onclick="logout()" class="p-2 text-slate-400 hover:text-rose-400 rounded-lg hover:bg-hoverBg transition-colors">
                <i data-lucide="log-out" class="w-4 h-4"></i>
            </button>
        </div>
    </aside>

    <!-- Mobile Overlay -->
    <div id="mobileOverlay" onclick="toggleMobileMenu()" class="fixed inset-0 bg-black/60 z-40 hidden lg:hidden backdrop-blur-sm"></div>

    <!-- MAIN ASSESSMENTS CONTENT -->
    <main class="flex-1 p-4 sm:p-6 lg:p-8 space-y-6 max-w-7xl mx-auto w-full">

        <!-- HEADER & TOOLBAR -->
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            <div>
                <h1 class="text-2xl font-extrabold text-white tracking-tight flex items-center gap-2.5">
                    <span>Assessments & Quizzes</span>
                    <span class="text-xs font-semibold px-2.5 py-1 bg-brand-500/20 text-brand-300 rounded-full border border-brand-500/30">Fall Term 2026</span>
                </h1>
                <p class="text-xs sm:text-sm text-slate-400 mt-1">Track pending midterms, take quick practice quizzes, and view detailed grade feedback.</p>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center gap-3">
                <button data-theme-toggle class="p-2.5 rounded-xl bg-inputBg border border-borderBg text-slate-400 hover:text-white transition-colors flex-shrink-0" title="Switch to light mode" aria-label="Switch to light mode" aria-pressed="false">
                    <i data-lucide="sun" class="w-4 h-4"></i>
                </button>
                <button onclick="openCreatePracticeModal()" class="px-4 py-2.5 bg-gradient-to-r from-brand-600 to-coral-500 hover:from-brand-500 hover:to-coral-400 text-white font-semibold text-xs rounded-xl shadow-lg shadow-brand-600/25 transition-all hover:-translate-y-0.5 flex items-center gap-2">
                    <i data-lucide="sparkles" class="w-4 h-4"></i>
                    <span>Generate Practice Quiz</span>
                </button>
            </div>
        </div>

        <!-- QUICK STATS OVERVIEW STRIP - the numbers come from the database -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

            <div class="bg-cardBg border border-borderBg rounded-2xl p-4 flex items-center gap-4 hover:border-brand-500/40 transition-colors">
                <div class="w-11 h-11 rounded-xl bg-brand-500/20 text-brand-400 flex items-center justify-center shrink-0">
                    <i data-lucide="check-check" class="w-5 h-5"></i>
                </div>
                <div>
                    <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Assessments Taken</span>
                    <div class="flex items-baseline gap-2 mt-0.5">
                        <span class="text-xl font-extrabold text-white"><%= progress ? progress.quizzes : 0 %></span>
                        <span class="text-[10px] text-slate-500 font-semibold">finished so far</span>
                    </div>
                </div>
            </div>

            <div class="bg-cardBg border border-borderBg rounded-2xl p-4 flex items-center gap-4 hover:border-emerald-500/40 transition-colors">
                <div class="w-11 h-11 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0">
                    <i data-lucide="trending-up" class="w-5 h-5"></i>
                </div>
                <div>
                    <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Average Score</span>
                    <div class="flex items-baseline gap-2 mt-0.5">
                        <span class="text-xl font-extrabold text-white"><%= progress ? progress.overall : 0 %>%</span>
                        <span class="text-[10px] text-emerald-400 font-semibold"><%= progress ? progress.accuracy : 0 %>% correct</span>
                    </div>
                </div>
            </div>

            <div class="bg-cardBg border border-borderBg rounded-2xl p-4 flex items-center gap-4 hover:border-coral-500/40 transition-colors">
                <div class="w-11 h-11 rounded-xl bg-coral-500/20 text-coral-400 flex items-center justify-center shrink-0">
                    <i data-lucide="clock" class="w-5 h-5"></i>
                </div>
                <div>
                    <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">Not Started</span>
                    <div class="flex items-baseline gap-2 mt-0.5">
                        <span class="text-xl font-extrabold text-white"><%= typeof openCount !== 'undefined' ? openCount : quizzes.length %></span>
                        <span class="text-[10px] text-coral-400 font-semibold">waiting for you</span>
                    </div>
                </div>
            </div>

            <div class="bg-cardBg border border-borderBg rounded-2xl p-4 flex items-center gap-4 hover:border-cyan-500/40 transition-colors">
                <div class="w-11 h-11 rounded-xl bg-cyan-500/20 text-cyan-400 flex items-center justify-center shrink-0">
                    <i data-lucide="file-badge-2" class="w-5 h-5"></i>
                </div>
                <div>
                    <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">In The Library</span>
                    <div class="flex items-baseline gap-2 mt-0.5">
                        <span class="text-xl font-extrabold text-white"><%= quizzes.length %></span>
                        <span class="text-[10px] text-slate-400 font-semibold">published quizzes</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- SEARCH, TABS & FILTERS BAR -->
        <div class="bg-cardBg border border-borderBg rounded-2xl p-4 flex flex-col md:flex-row items-center justify-between gap-4">
            
            <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
                <!-- Search Input -->
                <div class="relative w-full sm:w-64">
                    <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                    <input type="text" id="searchInput" oninput="applyFilters()" placeholder="Search assessment title..." 
                        class="w-full pl-10 pr-4 py-2 bg-inputBg border border-borderBg rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:border-brand-500 transition-colors">
                </div>

                <!-- Type Dropdown Filter -->
                <select id="typeFilter" onchange="applyFilters()" class="w-full sm:w-40 px-3 py-2 bg-inputBg border border-borderBg rounded-xl text-xs text-slate-300 focus:outline-none focus:border-brand-500 transition-colors">
                    <option value="ALL">All Types</option>
                    <option value="QUIZ">Quizzes</option>
                    <option value="MIDTERM">Midterm Exams</option>
                    <option value="PRACTICE">Practice Test</option>
                    <option value="ASSIGNMENT">Homework Assignment</option>
                </select>

                <!-- Status Filter Dropdown -->
                <select id="statusFilter" onchange="applyFilters()" class="w-full sm:w-36 px-3 py-2 bg-inputBg border border-borderBg rounded-xl text-xs text-slate-300 focus:outline-none focus:border-brand-500 transition-colors">
                    <option value="ALL">All Statuses</option>
                    <option value="UPCOMING">Upcoming</option>
                    <option value="IN_PROGRESS">In Progress</option>
                    <option value="COMPLETED">Completed</option>
                </select>
            </div>

            <!-- View Toggle Buttons -->
            <div class="flex items-center justify-between w-full md:w-auto gap-4">
                <span id="counterText" class="text-xs font-semibold text-slate-400">Showing 5 assessments</span>
                
                <div class="flex items-center bg-inputBg border border-borderBg rounded-xl p-1 gap-1">
                    <button id="btnGridView" onclick="setViewMode('grid')" class="p-1.5 rounded-lg text-white bg-brand-600 shadow-sm transition-all" title="Card View">
                        <i data-lucide="layout-grid" class="w-4 h-4"></i>
                    </button>
                    <button id="btnListView" onclick="setViewMode('list')" class="p-1.5 rounded-lg text-slate-400 hover:text-white transition-all" title="Table View">
                        <i data-lucide="list" class="w-4 h-4"></i>
                    </button>
                </div>
            </div>

        </div>

        <!-- CATEGORY TAB BADGES -->
        <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none">
            <button onclick="filterByTab('ALL', this)" class="tab-btn px-4 py-2 rounded-xl text-xs font-semibold bg-brand-600 text-white shadow-md shadow-brand-600/20 whitespace-nowrap">
                All Assessments (5)
            </button>
            <button onclick="filterByTab('UPCOMING', this)" class="tab-btn px-4 py-2 rounded-xl text-xs font-semibold bg-inputBg text-slate-400 hover:text-white hover:bg-hoverBg border border-borderBg whitespace-nowrap flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-coral-500 animate-urgent"></span>
                <span>Upcoming (2)</span>
            </button>
            <button onclick="filterByTab('IN_PROGRESS', this)" class="tab-btn px-4 py-2 rounded-xl text-xs font-semibold bg-inputBg text-slate-400 hover:text-white hover:bg-hoverBg border border-borderBg whitespace-nowrap">
                In Progress (1)
            </button>
            <button onclick="filterByTab('COMPLETED', this)" class="tab-btn px-4 py-2 rounded-xl text-xs font-semibold bg-inputBg text-slate-400 hover:text-white hover:bg-hoverBg border border-borderBg whitespace-nowrap">
                Completed (2)
            </button>
        </div>

        <!-- CARDS CONTAINER (GRID OR LIST VIEW) -->
        <div id="assessmentsContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">

            <%# The assessments the admin published - they come from the database %>
            <% if (typeof quizzes !== 'undefined' && quizzes && quizzes.length) { %>
                <% const jsText = function (value) { return String(value === null || value === undefined ? '' : value).replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '\\"'); }; %>
                <% quizzes.forEach(function (quiz) { %>
                    <% const count = quiz.question_count || quiz.total_questions || 0; %>
                    <% const marks = count * (quiz.points_per_question || 10); %>
                    <div class="assessment-card bg-cardBg border border-borderBg hover:border-brand-500/60 rounded-2xl p-5 transition-all hover:shadow-xl hover:-translate-y-1 group flex flex-col justify-between"
                         data-id="<%= quiz.slug %>" data-type="<%= quiz.type %>" data-status="<%= quiz.status %>" data-title="<%= quiz.title %>" data-subject="<%= quiz.subject %>">

                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <span class="px-2.5 py-1 rounded-md bg-brand-500/20 text-brand-300 text-[10px] font-bold uppercase tracking-wider"><%= quiz.subject %></span>
                                <span class="px-2.5 py-1 rounded-md bg-amber-500/20 text-amber-300 border border-amber-500/30 text-[10px] font-bold uppercase tracking-wider"><%= String(quiz.status).replace('_', ' ') %></span>
                            </div>

                            <h3 class="text-base font-bold text-white group-hover:text-brand-300 transition-colors leading-snug"><%= quiz.title %></h3>
                            <p class="text-xs text-slate-400 mt-1"><%= quiz.type %><% if (quiz.published_at) { %> - published <%= String(quiz.published_at).slice(0, 10) %><% } %></p>

                            <div class="my-4 p-3 bg-inputBg/80 rounded-xl grid grid-cols-3 gap-2 text-center border border-borderBg/70 text-xs">
                                <div>
                                    <span class="text-[10px] text-slate-500 block font-semibold uppercase">Questions</span>
                                    <span class="font-bold text-white"><%= count %> Qs</span>
                                </div>
                                <div>
                                    <span class="text-[10px] text-slate-500 block font-semibold uppercase">Time Limit</span>
                                    <span class="font-bold text-white"><%= quiz.duration_minutes %> Mins</span>
                                </div>
                                <div>
                                    <span class="text-[10px] text-slate-500 block font-semibold uppercase">Total Marks</span>
                                    <span class="font-bold text-white"><%= marks %> Pts</span>
                                </div>
                            </div>
                        </div>

                        <div class="pt-2">
                            <button onclick="startLiveAssessment('<%= jsText(quiz.title) %>', '<%= jsText(quiz.slug) %>')" class="w-full py-2.5 bg-brand-600 hover:bg-brand-500 text-white font-bold text-xs rounded-xl shadow-md transition-all flex items-center justify-center gap-2">
                                <i data-lucide="play" class="w-4 h-4"></i>
                                <span>Start Assessment</span>
                            </button>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>

            <!-- ASSESSMENT CARD 1: CS101 Live Quiz (In Progress) -->
            <div class="assessment-card bg-cardBg border border-borderBg hover:border-brand-500/60 rounded-2xl p-5 transition-all hover:shadow-xl hover:-translate-y-1 group flex flex-col justify-between"
                 data-id="quiz-101" data-type="QUIZ" data-status="IN_PROGRESS" data-title="Quiz #4: Async JS & Promises" data-subject="Computer Science">
                
                <div>
                    <!-- Top Badge -->
                    <div class="flex items-center justify-between mb-3">
                        <span class="px-2.5 py-1 rounded-md bg-brand-500/20 text-brand-300 text-[10px] font-bold uppercase tracking-wider">Computer Science</span>
                        <span class="px-2.5 py-1 rounded-md bg-amber-500/20 text-amber-300 border border-amber-500/30 text-[10px] font-bold uppercase tracking-wider flex items-center gap-1.5">
                            <i data-lucide="play-circle" class="w-3 h-3 text-amber-400"></i>
                            In Progress (3/10)
                        </span>
                    </div>

                    <h3 class="text-base font-bold text-white group-hover:text-brand-300 transition-colors leading-snug">Quiz #4: Async JS & Promises</h3>
                    <p class="text-xs text-slate-400 mt-1">CS101 - Intro to Web Development</p>

                    <!-- Metadata -->
                    <div class="my-4 p-3 bg-inputBg/80 rounded-xl grid grid-cols-3 gap-2 text-center border border-borderBg/70 text-xs">
                        <div>
                            <span class="text-[10px] text-slate-500 block font-semibold uppercase">Questions</span>
                            <span class="font-bold text-white">10 Qs</span>
                        </div>
                        <div>
                            <span class="text-[10px] text-slate-500 block font-semibold uppercase">Time Limit</span>
                            <span class="font-bold text-white">20 Mins</span>
                        </div>
                        <div>
                            <span class="text-[10px] text-slate-500 block font-semibold uppercase">Total Marks</span>
                            <span class="font-bold text-white">50 Pts</span>
                        </div>
                    </div>
                </div>

                <!-- Footer Action -->
                <div class="pt-2">
                    <button onclick="startLiveAssessment('Quiz #4: Async JS & Promises')" class="w-full py-2.5 bg-gradient-to-r from-brand-600 to-coral-500 hover:from-brand-500 hover:to-coral-400 text-white font-bold text-xs rounded-xl shadow-md transition-all flex items-center justify-center gap-2">
                        <i data-lucide="play" class="w-4 h-4"></i>
                        <span>Resume Quiz</span>
                    </button>
                </div>
            </div>

            <!-- ASSESSMENT CARD 2: MATH Midterm (Upcoming) -->
            <div class="assessment-card bg-cardBg border border-borderBg hover:border-brand-500/60 rounded-2xl p-5 transition-all hover:shadow-xl hover:-translate-y-1 group flex flex-col justify-between"
                 data-id="exam-202" data-type="MIDTERM" data-status="UPCOMING" data-title="Midterm Exam: Derivatives & Integrals" data-subject="Mathematics">
                
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <span class="px-2.5 py-1 rounded-md bg-cyan-500/20 text-cyan-300 text-[10px] font-bold uppercase tracking-wider">Mathematics</span>
                        <span class="px-2.5 py-1 rounded-md bg-rose-500/20 text-rose-300 border border-rose-500/30 text-[10px] font-bold uppercase tracking-wider flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-urgent"></span>
                            Due Tomorrow, 11:59 PM
                        </span>
                    </div>

                    <h3 class="text-base font-bold text-white group-hover:text-brand-300 transition-colors leading-snug">Midterm Exam: Derivatives & Integrals</h3>
                    <p class="text-xs text-slate-400 mt-1">MATH202 - Advanced Calculus</p>

                    <div class="my-4 p-3 bg-inputBg/80 rounded-xl grid grid-cols-3 gap-2 text-center border border-borderBg/70 text-xs">
                        <div>
                            <span class="text-[10px] text-slate-500 block font-semibold uppercase">Questions</span>
                            <span class="font-bold text-white">25 Qs</span>
                        </div>
                        <div>
                            <span class="text-[10px] text-slate-500 block font-semibold uppercase">Time Limit</span>
                            <span class="font-bold text-white">60 Mins</span>
                        </div>
                        <div>
                            <span class="text-[10px] text-slate-500 block font-semibold uppercase">Total Marks</span>
                            <span class="font-bold text-white">100 Pts</span>
                        </div>
                    </div>
                </div>

                <div class="pt-2">
                    <button onclick="startLiveAssessment('Midterm Exam: Derivatives & Integrals')" class="w-full py-2.5 bg-brand-600 hover:bg-brand-500 text-white font-bold text-xs rounded-xl shadow-md transition-all flex items-center justify-center gap-2">
                        <i data-lucide="play" class="w-4 h-4"></i>
                        <span>Start Assessment</span>
                    </button>
                </div>
            </div>

            <!-- ASSESSMENT CARD 3: Physics Test (Completed - 94%) -->
