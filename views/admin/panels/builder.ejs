<div class="qn-admin-panel p-4 sm:p-6 lg:p-8 space-y-6 max-w-7xl mx-auto w-full">
<%# Admin panel: builder - included by admin/adminportal.ejs %>

    <!-- THE HEADER OF THE WORKSPACE -->
    <div class="bg-cardBg border border-borderBg rounded-2xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400">Assessment Workspace</span>
            <h1 class="text-xl font-extrabold text-white flex items-center gap-2">
                <span>Exam &amp; Quiz Builder</span>
                <span class="text-xs font-normal text-slate-400">Updated on: <%= today %></span>
            </h1>
        </div>
        <div class="flex items-center gap-3 flex-wrap">
            <button id="builderNew" type="button" class="px-4 py-2 bg-inputBg hover:bg-borderBg text-slate-200 text-xs font-semibold rounded-xl border border-borderBg transition-all">
                New Assessment
            </button>
            <button id="builderSaveDraft" type="button" class="px-4 py-2 bg-inputBg hover:bg-borderBg text-slate-200 text-xs font-semibold rounded-xl border border-borderBg transition-all">
                Save Draft
            </button>
            <button id="builderPublish" type="button" class="px-5 py-2 bg-brandBlue hover:bg-brandHover text-white text-xs font-bold rounded-xl shadow-md transition-all glow-blue">
                Publish Exam
            </button>
        </div>
    </div>

    <!-- THE THREE COLUMNS OF THE BUILDER -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

        <!-- 1. THE SUBJECTS (3 columns) -->
        <div class="lg:col-span-3 bg-cardBg border border-borderBg rounded-2xl p-4 space-y-4">
            <div class="flex items-center justify-between px-1">
                <span class="text-xs font-extrabold uppercase tracking-wider text-slate-400">Subjects</span>
                <div class="flex items-center gap-3">
                    <span id="builderSubjectTotal" class="text-[10px] font-mono text-slate-500"></span>
                    <button id="addSubjectBtn" type="button" class="text-brandBlue hover:text-white text-xs font-bold">+</button>
                </div>
            </div>

            <div class="space-y-1 max-h-[26rem] overflow-y-auto pr-1" id="subjectList">
                <% subjects.forEach(function (subject, index) { %>
                    <% const config = (typeof subjectSettings !== 'undefined' && subjectSettings[subject.name]) || { question_count: 10 }; %>
                    <% const count = quizzes.filter(function (quiz) { return quiz.subject === subject.name; }).length; %>
                    <button type="button" onclick="builderSelectSubject(this, '<%= subject.name %>')" data-subject="<%= subject.name %>"
                        class="subject-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl <%= index === 0 ? 'bg-brandBlue text-white font-bold text-xs shadow-md' : 'text-slate-400 hover:text-white hover:bg-inputBg text-xs font-medium transition-colors' %>">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <i data-lucide="<%= subject.icon %>" class="w-4 h-4 flex-shrink-0"></i>
                            <span class="truncate"><%= subject.name %></span>
                        </div>
                        <span class="text-[10px] <%= index === 0 ? 'bg-white/20' : 'bg-inputBg' %> px-2 py-0.5 rounded font-mono flex-shrink-0" data-subject-count><%= config.question_count %> Qs</span>
                    </button>
                <% }); %>
            </div>
        </div>

        <!-- 2. THE EDITOR (6 columns) -->
        <div class="lg:col-span-6 space-y-4">

            <!-- The details of the assessment -->
            <div class="bg-cardBg border border-borderBg rounded-2xl p-5 space-y-4">
                <div class="flex items-center justify-between gap-3 border-b border-borderBg pb-3">
                    <h3 class="text-sm font-extrabold text-white">The assessment</h3>
                    <div class="flex items-center gap-3">
                        <span id="builderSaveState" class="text-[10px] font-semibold text-slate-400">All changes are saved</span>
                        <span id="builderState" class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-inputBg text-slate-400">New</span>
                    </div>
                </div>

                <div>
                    <label class="block text-slate-300 font-semibold mb-1 text-xs" for="builderTitle">Title</label>
                    <input type="text" id="builderTitle" placeholder="Quiz #5: Algebra Basics"
                        class="w-full px-3 py-2.5 bg-inputBg border border-borderBg rounded-xl text-sm text-white placeholder-slate-500 focus:outline-none focus:border-brandBlue transition-colors">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-slate-300 font-semibold mb-1 text-xs" for="builderType">Type</label>
                        <select id="builderType" class="w-full px-3 py-2 bg-inputBg border border-borderBg rounded-xl text-sm text-white focus:outline-none focus:border-brandBlue">
                            <option value="QUIZ">Quiz</option>
                            <option value="ASSIGNMENT">Assignment</option>
                            <option value="MIDTERM">Midterm</option>
                            <option value="MOCK">Mock</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-slate-300 font-semibold mb-1 text-xs" for="builderDuration">Minutes</label>
                        <input type="number" id="builderDuration" min="1" max="240"
                            class="w-full px-3 py-2 bg-inputBg border border-borderBg rounded-xl text-sm text-white focus:outline-none focus:border-brandBlue">
                    </div>
                </div>

                <!-- The settings of the subject: how many questions it gets -->
                <div class="rounded-xl border border-brandBlue/30 bg-brandBlue/5 p-4 space-y-3">
                    <div class="flex items-center justify-between gap-3">
                        <span class="text-xs font-bold text-white">The questions of <span id="builderSubjectName">the subject</span></span>
                        <span id="builderSettingsState" class="text-[10px] text-slate-400">saved</span>
                    </div>
                    <p class="text-[11px] text-slate-400 leading-relaxed">
                        The builder creates exactly as many question slots as you set here - every assessment of this
                        subject gets the same number of questions.
                    </p>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-slate-400 font-semibold mb-1 text-[11px]" for="builderQuestionCount">Questions</label>
                            <input type="number" id="builderQuestionCount" min="1" max="100"
                                class="w-full px-3 py-2 bg-inputBg border border-borderBg rounded-xl text-sm text-white focus:outline-none focus:border-brandBlue">
                        </div>
                        <div>
                            <label class="block text-slate-400 font-semibold mb-1 text-[11px]" for="builderOptionCount">Answers per question</label>
                            <select id="builderOptionCount" class="w-full px-3 py-2 bg-inputBg border border-borderBg rounded-xl text-sm text-white focus:outline-none focus:border-brandBlue">
                                <option value="2">2 answers</option>
                                <option value="3">3 answers</option>
                                <option value="4">4 answers</option>
                                <option value="5">5 answers</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-slate-400 font-semibold mb-1 text-[11px]" for="builderSubjectDuration">Minutes of the subject</label>
                            <input type="number" id="builderSubjectDuration" min="1" max="240"
                                class="w-full px-3 py-2 bg-inputBg border border-borderBg rounded-xl text-sm text-white focus:outline-none focus:border-brandBlue">
                        </div>
                        <div>
                            <label class="block text-slate-400 font-semibold mb-1 text-[11px]" for="builderPoints">Points per question</label>
                            <input type="number" id="builderPoints" min="1" max="100"
                                class="w-full px-3 py-2 bg-inputBg border border-borderBg rounded-xl text-sm text-white focus:outline-none focus:border-brandBlue">
                        </div>
                    </div>
                </div>
            </div>

            <!-- The question that is open - one question, one page -->
            <div id="builderQuestions" class="space-y-4"></div>

            <!-- The navigation between the questions -->
            <div class="bg-cardBg border border-borderBg rounded-2xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex items-center gap-2 flex-shrink-0">
                    <button id="builderPrevQuestion" type="button" class="px-4 py-2 bg-inputBg hover:bg-borderBg text-slate-300 font-semibold text-xs rounded-xl border border-borderBg transition-all flex items-center gap-1.5 whitespace-nowrap">
                        <i data-lucide="chevron-left" class="w-4 h-4"></i>
                        <span>Previous</span>
                    </button>
                    <button id="builderNextQuestion" type="button" class="px-4 py-2 bg-brandBlue hover:bg-brandHover text-white font-bold text-xs rounded-xl shadow-md transition-all flex items-center gap-1.5 whitespace-nowrap">
                        <span>Next question</span>
                        <i data-lucide="chevron-right" class="w-4 h-4"></i>
                    </button>
                </div>

                <div class="flex items-center gap-3 flex-wrap justify-end">
                    <span id="builderProgress" class="text-xs text-slate-400 whitespace-nowrap">0 of 10 questions are ready</span>
                    <button id="builderAddQuestion" type="button" class="px-3 py-2 bg-inputBg hover:bg-borderBg text-slate-300 text-xs font-semibold rounded-xl border border-borderBg transition-all flex items-center gap-1.5 whitespace-nowrap">
                        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                        <span>one more</span>
                    </button>
                </div>
            </div>

            <!-- THE QUEUE - the next assessment to build -->
            <div class="bg-gradient-to-r from-brandBlue/20 via-brandBlue/10 to-cyanAccent/10 border border-brandBlue/30 rounded-2xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="min-w-0">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-brandBlue">The queue of this subject</p>
                    <p id="builderQueue" class="text-sm font-extrabold text-white truncate">A new assessment</p>
                    <p class="text-[11px] text-slate-400 truncate">Next: <span id="builderNextName" class="text-slate-300">a new assessment</span></p>
                </div>

                <button id="builderNextAssessment" type="button" class="px-5 py-2.5 bg-brandBlue hover:bg-brandHover text-white text-xs font-bold rounded-xl shadow-md shadow-brandBlue/25 transition-all flex items-center gap-2 flex-shrink-0">
                    <span>Next assessment</span>
                    <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </button>
            </div>
        </div>

        <!-- 3. THE MATRIX AND THE ASSESSMENTS (3 columns) -->
        <div class="lg:col-span-3 space-y-4">
            <div class="bg-cardBg border border-borderBg rounded-2xl p-5 space-y-4">
                <div class="flex items-center justify-between gap-2">
                    <span class="text-xs font-bold text-white whitespace-nowrap">Questions</span>
                    <span id="builderMatrixCounter" class="text-[10px] font-mono text-slate-400 whitespace-nowrap">0 of 0</span>
                </div>

                <div id="builderMatrix" class="grid grid-cols-5 gap-2.5"></div>

                <div class="pt-2 border-t border-borderBg space-y-1.5 text-[11px] text-slate-400">
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-brandBlue inline-block"></span>
                        <span>The question you are on</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-emeraldSuccess inline-block"></span>
                        <span>Ready</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-inputBg inline-block"></span>
                        <span>Still empty</span>
                    </div>
                </div>
            </div>

            <div class="bg-cardBg border border-borderBg rounded-2xl p-5 space-y-3">
                <div class="flex items-center justify-between gap-2">
                    <span class="text-xs font-bold text-white">The assessments</span>
                    <span id="builderQuizCount" class="text-[10px] font-mono text-slate-400 whitespace-nowrap"></span>
                </div>
                <div id="builderQuizList" class="space-y-2">
                    <p class="qn-admin-loading">The assessments are loading...</p>
                </div>
            </div>
        </div>
    </div>
</div>
