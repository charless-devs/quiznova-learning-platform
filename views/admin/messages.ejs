<%# Admin panel: messages - the inbox of the student messages %>
<div class="qn-admin-panel p-4 sm:p-6 lg:p-8 space-y-6 max-w-7xl mx-auto w-full">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-extrabold text-white tracking-tight">Student Messages</h1>
            <p class="text-xs sm:text-sm text-slate-400 mt-0.5">
                <span id="openCounter"><%= inbox.filter(function (item) { return item.status === 'open'; }).length %></span>
                waiting - <%= inbox.length %> in total
            </p>
        </div>

        <div class="flex items-center gap-2">
            <button class="qn-filter is-active" data-status="all">All <span class="qn-filter__count"><%= inbox.length %></span></button>
            <button class="qn-filter" data-status="open">Open <span class="qn-filter__count"><%= inbox.filter(function (item) { return item.status === 'open'; }).length %></span></button>
            <button class="qn-filter" data-status="answered">Answered <span class="qn-filter__count"><%= inbox.filter(function (item) { return item.status === 'answered'; }).length %></span></button>
            <button class="qn-filter" data-status="closed">Closed <span class="qn-filter__count"><%= inbox.filter(function (item) { return item.status === 'closed'; }).length %></span></button>
        </div>
    </div>

    <!-- Empty state -->
    <section id="inboxEmpty" class="qn-card p-12 text-center space-y-3 <%= inbox.length ? 'hidden' : '' %>">
        <div class="w-14 h-14 mx-auto rounded-2xl bg-brandBlue/15 text-brandBlue flex items-center justify-center">
            <i data-lucide="inbox" class="w-7 h-7"></i>
        </div>
        <h2 class="text-base font-extrabold text-white">No messages yet</h2>
        <p class="text-sm text-slate-400">When a student writes to QuizNova Support, the message lands here.</p>
    </section>

    <!-- Inbox + detail -->
    <div class="grid grid-cols-1 lg:grid-cols-[22rem_1fr] gap-6 items-start">

        <!-- List -->
        <section class="qn-card overflow-hidden">
            <div id="messageList" class="divide-y divide-borderBg/60 max-h-[32rem] overflow-y-auto">
                <% inbox.forEach(function (item) { %>
                    <button class="qn-message <%= item.status === 'open' ? 'is-open' : '' %>" data-message data-status="<%= item.status %>" data-id="<%= item.id %>" data-search="<%= (item.full_name + ' ' + item.email + ' ' + item.subject + ' ' + item.body).toLowerCase() %>">
                        <span class="flex items-center justify-between gap-2">
                            <span class="text-xs font-bold text-white truncate"><%= item.subject %></span>
                            <span class="qn-status is-<%= item.status %>"><%= item.status %></span>
                        </span>
                        <span class="block text-[11px] text-slate-400 truncate mt-1"><%= item.full_name %> - <%= item.body %></span>
                        <span class="flex items-center justify-between gap-2 mt-2">
                            <span class="text-[10px] text-slate-500 truncate"><%= item.email %></span>
                            <span class="text-[10px] text-slate-500 flex-shrink-0"><%= String(item.created_at).slice(0, 16) %></span>
                        </span>
                    </button>
                <% }); %>
            </div>
        </section>

        <!-- Detail -->
        <section id="messageDetail" class="qn-card p-5 sm:p-6 space-y-5 <%= inbox.length ? '' : 'hidden' %>">
            <div id="detailEmpty" class="hidden py-12 text-center space-y-2">
                <i data-lucide="mouse-pointer-click" class="w-8 h-8 mx-auto text-slate-600"></i>
                <p class="text-sm text-slate-400">Pick a message on the left to read and answer it.</p>
            </div>

            <div id="detailBody" class="space-y-5 <%= inbox.length ? '' : 'hidden' %>">
                <!-- Subject + student -->
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="min-w-0">
                        <h2 id="detailSubject" class="text-lg font-extrabold text-white truncate"></h2>
                        <p id="detailStudent" class="text-xs text-slate-400 mt-1"></p>
                    </div>
                    <span id="detailStatus" class="qn-status is-open"></span>
                </div>

                <!-- The message -->
                <div class="rounded-xl border border-borderBg bg-inputBg/60 p-4">
                    <p class="text-[10px] uppercase tracking-wider text-slate-500 font-semibold mb-2">The student wrote</p>
                    <p id="detailBodyText" class="text-sm text-slate-200 leading-relaxed whitespace-pre-line"></p>
                    <p id="detailDate" class="text-[10px] text-slate-500 mt-3"></p>
                </div>

                <!-- The reply -->
                <div id="detailReplyBox" class="rounded-xl border border-emeraldSuccess/30 bg-emeraldSuccess/5 p-4 hidden">
                    <p class="text-[10px] uppercase tracking-wider text-emeraldSuccess font-semibold mb-2">Your reply</p>
                    <p id="detailReplyText" class="text-sm text-slate-200 leading-relaxed whitespace-pre-line"></p>
                </div>

                <!-- Answer -->
                <div class="space-y-3">
                    <label for="replyText" class="text-xs font-bold text-white">Write a reply</label>
                    <textarea id="replyText" rows="4" placeholder="Tell the student what happens next..."
                        class="w-full resize-none bg-inputBg border border-borderBg rounded-xl px-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-brandBlue transition-all"></textarea>
                    <p id="replyError" class="hidden text-xs text-rose-400"></p>

                    <div class="flex flex-wrap items-center gap-3">
                        <button id="sendReply" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-brandBlue hover:bg-brandHover text-white text-xs font-bold transition-colors">
                            <i data-lucide="send" class="w-4 h-4"></i>
                            <span>Send reply</span>
                        </button>
                        <button id="closeMessage" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-inputBg hover:bg-hoverBg border border-borderBg text-slate-300 hover:text-white text-xs font-semibold transition-all">
                            <i data-lucide="check-check" class="w-4 h-4"></i>
                            <span>Mark as closed</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
